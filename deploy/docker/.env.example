# Copy to .env beside compose.yaml, then set these values for your server.
# Prefer the server's VPN IP and HTTPS for traffic beyond one machine.
MAGPIE_BIND_IP=127.0.0.1
MAGPIE_PUBLIC_URL=http://127.0.0.1:3425
# Generate with: openssl rand -hex 32
MAGPIE_WEB_KEY=replace-with-a-random-key-at-least-16-characters
# Optional: pin a published release instead of following latest.
# MAGPIE_IMAGE=ghcr.io/latentharbor/magpie:0.1.1351
